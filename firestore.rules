rules_version = '2';

/* Reglas de Bloom Pastelería (mismo esquema que la tienda Shop).
   La gestión es solo de la dueña: la cuenta de Google bloompasteleriacl@gmail.com (correo verificado).
   Ninguna otra cuenta puede leer ni crear datos. El público (la tienda) solo puede leer la
   Configuración, el catálogo y las fotos, y dejar un pedido en la tienda de la dueña.
   Para cambiar de dueña: cambiar el correo aquí y en src/store/firebase.ts (CORREO_DUENA). */
service cloud.firestore {
  match /databases/{database}/documents {

    function enlaceBloom() {
      return /databases/$(database)/documents/enlaces/bloom;
    }

    /* uid de la tienda vinculada a la dirección corta "bloom" */
    function esLaTienda(uid) {
      return exists(enlaceBloom()) && get(enlaceBloom()).data.uid == uid;
    }

    /* sesión iniciada con el correo de la dueña, verificado por Google */
    function esCorreoDuena() {
      return request.auth != null
        && request.auth.token.email == 'bloompasteleriacl@gmail.com'
        && request.auth.token.email_verified == true;
    }

    /* la dueña: su cuenta, vinculada a la tienda */
    function esDueno(uid) {
      return esCorreoDuena() && request.auth.uid == uid && esLaTienda(uid);
    }

    function texto(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }

    function numero(d, campo) {
      return !(campo in d) || (d[campo] is number && d[campo] >= 0 && d[campo] <= 100000000);
    }

    /* pedido que deja un cliente desde la tienda: solo estos campos, con tamaños acotados */
    function pedidoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['cliente', 'whatsapp', 'items', 'estado'])
        && d.keys().hasOnly(['cliente', 'whatsapp', 'items', 'producto', 'precio', 'abono', 'fecha', 'entrega',
                             'notas', 'canal', 'estado', 'origen', 'nuevo', 'urgente', 'creado'])
        && d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 120
        && d.whatsapp is string && d.whatsapp.size() > 0 && d.whatsapp.size() <= 40
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.estado == 'pendiente'
        && (!('origen' in d) || d.origen == 'tienda')
        && (!('nuevo' in d) || d.nuevo == true)
        && (!('urgente' in d) || d.urgente == false)
        && (!('canal' in d) || d.canal == 'Web')
        && texto(d, 'producto', 300) && texto(d, 'entrega', 200) && texto(d, 'notas', 300)
        && texto(d, 'fecha', 10) && texto(d, 'creado', 40)
        && numero(d, 'precio') && numero(d, 'abono');
    }

    /* dirección corta: pública para leer; solo la dueña la crea o la apunta a su cuenta */
    match /enlaces/{nombre} {
      allow read: if true;
      allow create, update: if nombre == 'bloom' && esCorreoDuena()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if esCorreoDuena();
    }

    match /tiendas/{uid} {
      /* ajustes privados */
      allow read, write: if esDueno(uid);

      /* Configuración de la tienda (publico/tienda): la ve la tienda, la cambia la dueña */
      match /publico/{docId} {
        allow read: if true;
        allow write: if esDueno(uid);
      }

      /* catálogo: lo ve la tienda, lo cambia la dueña */
      match /catalogo/{docId} {
        allow read: if true;
        allow write: if esDueno(uid);
      }

      /* fotos de productos: { img: data URL jpg, actualizado }, bajo 1 MB por documento */
      match /fotos/{docId} {
        allow read: if true;
        allow create, update: if esDueno(uid)
          && request.resource.data.keys().hasOnly(['img', 'actualizado'])
          && request.resource.data.img is string
          && request.resource.data.img.matches('^data:image/jpeg;base64,.*');
        allow delete: if esDueno(uid);
      }

      /* pedidos: cualquiera puede dejar uno desde la tienda; solo la dueña los lee, cambia o borra */
      match /pedidos/{docId} {
        allow read, update, delete: if esDueno(uid);
        allow create: if esDueno(uid) || (esLaTienda(uid) && pedidoValido());
      }

      /* recetas, clientes, insumos y cualquier otra colección: solo la dueña */
      match /{coleccion}/{docId} {
        allow read, write: if esDueno(uid);
      }
    }
  }
}
